#!/bin/bash
# Score a manifest with a RoboRef / Robometer checkpoint (inference/INFERENCE.md).
#   MANIFEST=m.jsonl OUT=s.jsonl [MODEL=...] [CUTS=10.0,5.0] [LIMIT=N] sbatch inference/score.job
#SBATCH --job-name=roboref_score
#SBATCH --partition=cees
#SBATCH --account=ceesusers
#SBATCH --gres=gpu:rtx_a5000:1
#SBATCH --cpus-per-task=8
#SBATCH --mem=40G
#SBATCH --time=06:00:00
#SBATCH --output=/home/pkarage/RoboRef/inference/logs/score_%j.log
set -eo pipefail
: "${MANIFEST:?set MANIFEST}" "${OUT:?set OUT}"
MANIFEST=$(realpath "$MANIFEST"); OUT=$(realpath -m "$OUT")   # the job changes directory below
export HF_HOME=/home/pkarage/.cache/huggingface HF_HUB_OFFLINE=1 HF_HUB_DISABLE_PROGRESS_BARS=1
export PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
hostname; nvidia-smi --query-gpu=name --format=csv,noheader
cd /home/pkarage/RoboRef/Robometer
/home/pkarage/RoboRef/Robometer/.venv/bin/python /home/pkarage/RoboRef/inference/roboref_infer.py score \
  --manifest "$MANIFEST" --out "$OUT" --model "${MODEL:-/home/pkarage/checkpoints/roboref_run2_noicl_ours_step4000}" \
  ${CUTS:+--cuts $CUTS} ${PREFIX:+--prefix-every $PREFIX} ${LIMIT:+--limit $LIMIT}
